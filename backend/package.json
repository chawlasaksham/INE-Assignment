{
  "name": "price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend and scraper engine for INE Product Price Tracker",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest tests/unit --verbose",
    "test:unit": "jest tests/unit --verbose",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest tests/integration --verbose --runInBand",
    "scraper:headed": "node scripts/runHeaded.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
