{
  "name": "ine-product-price-tracker",
  "version": "1.0.0",
  "description": "Product Price Tracker for INE Mock Store",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "scraper:headed": "cd backend && npm run scraper:headed",
    "test": "cd backend && npm test",
    "test:unit": "cd backend && npm run test:unit",
    "test:integration": "cd backend && npm run test:integration"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

